{
  "name": "cognisphere-ios",
  "version": "1.0.0",
  "private": true,
  "description": "Cognisphere for iPhone — nine bilingual mini-games (Capacitor 8).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync": "npm run build && cap sync ios",
    "open": "cap open ios",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "npm run build && node tests/e2e/run.mjs",
    "test:all": "npm test && npm run test:e2e",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "jspdf": "4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "esbuild": "0.28.2"
  }
}
